# ============================================================
# StowFlow — variables d'environnement (référence)
# ============================================================
#
# Docker : copier vers .env.docker (optionnel) — voir .env.docker.example
# Local API : stowflow-api/application-local.yml (gitignoré) ou variables ci-dessous
# Local front : inventra-web/.env.local (optionnel)
#
# ============================================================

# --- PostgreSQL (local ou Docker) ---
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/stowflow
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=root
# POSTGRES_DB=stowflow
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=root

# --- JWT (obligatoire en production, ≥ 32 caractères) ---
# JWT_SECRET=change-me-in-production-min-32-chars!!

# --- Google Gemini (assistant chat, optionnel) ---
# GEMINI_API_KEY=
# INVENTRA_GEMINI_ENABLED=true

# --- Frontend (optionnel — dev utilise le proxy Next.js par défaut) ---
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_TENANT_SLUG=default

# --- Docker Compose (réseau interne) ---
# POSTGRES_PORT=5433
# API_PORT=8000
# WEB_PORT=3000
# API_PROXY_TARGET=http://stowflow-api:8000
